# API used by the browser (axios) — baked into the build
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# API used by server components (SSR). Can be an internal address, e.g. a docker service name
SERVER_API_URL=http://localhost:4000/api

# public address of this site — used for canonical urls, sitemap.xml and open graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
